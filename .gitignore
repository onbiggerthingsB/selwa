# generated service worker (Serwist)
/public/sw.js
/public/swe-worker-*.js

# generated validation reports (run via `npm run validate`)
/validation/report.json
/validation/report.md

# claude code local settings (keep launch.json tracked)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

