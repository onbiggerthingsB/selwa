# Copy to .env.local and set the required server-only values.
# Never prefix any of these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
# Use a random secret of at least 32 characters; for example: openssl rand -hex 32
RATE_LIMIT_IP_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional paid-route limits. These are the production defaults when omitted.
# RATE_LIMIT_NAMESPACE=development
RATE_LIMIT_BURST_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_WINDOW_SECONDS=86400
RATE_LIMIT_EXTRACT_BURST=3
RATE_LIMIT_TRANSLATE_NOTES_BURST=10
RATE_LIMIT_DAILY_UNITS=60
RATE_LIMIT_EXTRACT_COST_UNITS=5
RATE_LIMIT_TRANSLATE_NOTES_COST_UNITS=1
RATE_LIMIT_STORE_TIMEOUT_MS=1500
