{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-translator.local/research/contracts/study.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "study_id", "status", "evidence_kind", "population", "writing_style", "community", "first_task", "condition", "critical_failure_categories", "pilot", "candidate_ids", "clinical_review_available", "registered_by", "registered_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "tibetan_comprehension_study"},
    "study_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["draft", "preregistered"]},
    "evidence_kind": {"enum": ["human_review", "synthetic_test"]},
    "population": {"type": "string", "minLength": 1, "maxLength": 4000},
    "writing_style": {"type": "string", "minLength": 1, "maxLength": 4000},
    "condition": {"type": ["object", "null"]},
    "development_config_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "community": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false,
        "required": ["community_id", "description", "language_variety"],
        "properties": {"community_id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"}, "language_variety": {"$ref": "#/$defs/text"}}
      }]
    },
    "first_task": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "description", "answer_kind", "labels", "no_answer_label", "review_criteria"],
        "properties": {
          "task_id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"},
          "answer_kind": {"enum": ["exact_label", "extraction"]},
          "labels": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"$ref": "#/$defs/text"}},
          "no_answer_label": {"$ref": "#/$defs/text"}, "review_criteria": {"$ref": "#/$defs/text"}
        }
      }]
    },
    "critical_failure_categories": {
      "type": "array", "maxItems": 30,
      "items": {"type": "object", "additionalProperties": false, "required": ["category_id", "definition"], "properties": {"category_id": {"$ref": "#/$defs/id"}, "definition": {"$ref": "#/$defs/text"}}}
    },
    "pilot": {
      "type": "object", "additionalProperties": false,
      "required": ["planned_item_count", "item_unit", "minimum_reviewers", "expected_item_ids"],
      "properties": {
        "planned_item_count": {"const": 10}, "item_unit": {"const": "model_output_case"},
        "minimum_reviewers": {"type": "integer", "minimum": 2, "maximum": 8},
        "expected_item_ids": {"type": "array", "uniqueItems": true, "maxItems": 10, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "clinical_review_available": {"type": "boolean"},
    "registered_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "registered_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 8000}
  }
}
