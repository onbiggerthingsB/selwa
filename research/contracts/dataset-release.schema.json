{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-translator.local/research/contracts/dataset-release.schema.json",
  "title": "Private immutable purpose-separated dataset release",
  "type": "object", "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "release_id", "created_at", "evidence_kind", "engineering_only", "contributor_policy", "inputs", "splits", "artifacts", "permissions_path", "history_path", "limitations"],
  "properties": {
    "schema_kind": {"const": "dataset_release"},
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_kind": {"enum": ["human_review", "synthetic_test"]},
    "engineering_only": {"type": "boolean"},
    "contributor_policy": {"enum": ["report", "disjoint"]},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_file_sha256", "dataset_canonical_sha256", "reconciled_dataset_canonical_sha256", "permissions_file_sha256", "permissions_canonical_sha256"],
      "properties": {
        "dataset_file_sha256": {"$ref": "#/$defs/hash"},
        "dataset_canonical_sha256": {"$ref": "#/$defs/hash"},
        "reconciled_dataset_canonical_sha256": {"$ref": "#/$defs/hash"},
        "permissions_file_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "permissions_canonical_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "splits": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/split"}},
    "artifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact"}},
    "permissions_path": {"const": "permissions.json"},
    "history_path": {"const": "history.json"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"evidence_kind": {"const": "synthetic_test"}}}, "then": {"properties": {"engineering_only": {"const": true}}}, "else": {"properties": {"engineering_only": {"const": false}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "purpose": {"enum": ["development_screen", "smoke_training", "train", "validation", "final_test"]},
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "example_ids", "source_ids", "example_count", "dataset_path", "dataset_canonical_sha256", "audit_path", "references_path"],
      "properties": {
        "purpose": {"$ref": "#/$defs/purpose"},
        "example_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "example_count": {"type": "integer", "minimum": 1},
        "dataset_path": {"type": "string"},
        "dataset_canonical_sha256": {"$ref": "#/$defs/hash"},
        "audit_path": {"type": "string"},
        "references_path": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
