{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-translator.local/research/contracts/chat.schema.json",
  "$comment": "The fake-only chat contract requires semantic validation in addition to JSON Schema: Unicode scalar strings, exact source hashes, known source bindings, alternating history with at most 8000 total code points, and response/request identity and citation binding. Versions accept mathematically integral JSON numbers, exclude booleans, and cannot exceed the JavaScript safe integer range. No field grants language or clinical approval.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/catalog"}
  ],
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "source_id": {"$ref": "#/$defs/nonblank"},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$", "not": {"pattern": "[^A-Za-z0-9._-]"}, "minLength": 1, "maxLength": 64},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version", "content_sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "version": {"$ref": "#/$defs/version"},
        "content_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "source_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version", "content_sha256", "title", "original_text", "language", "source_kind", "scope", "language_review", "medical_review"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "version": {"$ref": "#/$defs/version"},
        "content_sha256": {"$ref": "#/$defs/hash"},
        "title": {"$ref": "#/$defs/nonblank"},
        "original_text": {"$ref": "#/$defs/nonblank"},
        "language": {"enum": ["en", "bo", "zh"]},
        "source_kind": {"const": "synthetic_fixture"},
        "scope": {"const": "nonclinical"},
        "language_review": {"const": "pending"},
        "medical_review": {"const": "not_applicable"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"$ref": "#/$defs/nonblank", "maxLength": 2000}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "source", "messages"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "source": {"$ref": "#/$defs/citation"},
        "messages": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"$ref": "#/$defs/message"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "outcome", "answer", "citations", "model_identity", "synthetic", "input_tokens", "output_tokens"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "outcome": {"enum": ["success", "timeout", "cancelled", "context_overflow", "runtime_failure"]},
        "answer": {"oneOf": [{"$ref": "#/$defs/nonblank", "maxLength": 4000}, {"type": "null"}]},
        "citations": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "model_identity": {"const": "fake://research-chat-v1"},
        "synthetic": {"type": "boolean", "const": true},
        "input_tokens": {"type": "null"},
        "output_tokens": {"type": "null"}
      },
      "allOf": [{
        "if": {"properties": {"outcome": {"const": "success"}}, "required": ["outcome"]},
        "then": {"properties": {"answer": {"$ref": "#/$defs/nonblank", "maxLength": 4000}, "citations": {"minItems": 1, "maxItems": 1}}},
        "else": {"properties": {"answer": {"type": "null"}, "citations": {"maxItems": 0}}}
      }]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "sources"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "mode": {"const": "synthetic_demo"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/source_card"}}
      }
    }
  }
}
